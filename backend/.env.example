# ─────────────────────────────────────────────────────────────
# CropYieldAI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME="CropYieldAI"
APP_VERSION="1.0.0"
APP_ENV="development"            # development | production
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# Database
# SQLite (default — recommended for development / academic projects)
DATABASE_URL="sqlite+aiosqlite:///./cropai.db"

# PostgreSQL (uncomment for production)
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/cropai_db"

# Security
SECRET_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML Artifacts — paths to saved model files
MODEL_PATH="trained_models/model.joblib"
SCALER_PATH="trained_models/scaler.joblib"
ENCODERS_PATH="trained_models/label_encoders.joblib"
FEATURE_NAMES_PATH="trained_models/feature_names.joblib"

# CORS — comma-separated allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/cropai.log"
